# Auto detect text files and perform LF normalization
* text=auto

# Explicitly set bash scripts to have unix endings
*.sh text eol=lf
distribution/osx/Radarr text eol=lf

# Custom for Visual Studio
*.cs     diff=csharp
*.sln    merge=union

# Preserve upstream legal notices verbatim, including their original spacing.
distribution/licenses/SkiaSharp-*.txt -text whitespace=-blank-at-eol
