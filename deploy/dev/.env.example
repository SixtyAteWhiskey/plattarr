# Image built by .github/workflows/image.yml (public on GHCR, no login needed).
PLATTARR_IMAGE=ghcr.io/sixtyatewhiskey/plattarr:develop

# Must match the owner of the files under DATA_PATH (SERVER01: collin, 1000:1000).
PUID=1000
PGID=1000

# One mount for the whole media tree so hardlinks and atomic moves work.
# SERVER01: /mnt/share/Media (ext4 on /dev/md10) holds Movies/, Shows/, Music/, Importing/.
DATA_PATH=/mnt/share/Media
